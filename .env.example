# Credentials for the command line (pyramid export ...) when --client is not given.
# Copy to .env and never commit it. The desktop app and "pyramid web" use the
# clients saved in pyramid.cfg instead.

GC_REGION=us_east_1
GC_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GC_CLIENT_SECRET=your_client_secret_here
GC_PROXY_URL=
